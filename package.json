{
  "name": "axel-alvarez-portfolio-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio d'Axel Alvarez — build SCSS",
  "scripts": {
    "css": "sass assets/scss/main.scss assets/css/main.css --style=expanded --no-source-map",
    "build:css": "sass assets/scss/main.scss assets/css/main.css --style=expanded --no-source-map",
    "watch:css": "sass --watch assets/scss/main.scss assets/css/main.css --style=expanded --no-source-map"
  },
  "devDependencies": {
    "sass": "1.77.8"
  }
}
